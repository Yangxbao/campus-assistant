# =====================================================================
# 湖南工商大学校园助手 —— 环境变量模板（.env.example）
# 复制为 .env 后按需修改；真实密钥绝不硬编码进代码。
# 全部变量均有安全默认值，本地开发可不配置。
# =====================================================================

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=campus_assistant
MYSQL_USER=root
MYSQL_PASSWORD=campus123

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 服务 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=

# ---------- JWT（生产必须更换为强随机值） ----------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_HOURS=72

# ---------- 上传 ----------
# 本地存储目录（相对路径则相对进程工作目录）
UPLOAD_DIR=./upload-dir
UPLOAD_MAX_SIZE_MB=8

# ---------- 微信小程序 ----------
# 未配置时登录走开发模式 devMode（按 code 生成确定性虚拟 openid）
WX_APPID=
WX_SECRET=
# 课程提醒订阅消息模板 ID（未配置时推送标记 notConfigured）
WX_TIMETABLE_TEMPLATE_ID=

# ---------- OCR ----------
# OCR_ENABLED=false 时课表 OCR 链路返回 code=50301"OCR 服务未配置"
OCR_ENABLED=false
# HttpOcrService 配置：第三方 OCR HTTP 接口（POST，multipart 字段 file）
OCR_HTTP_URL=
OCR_HTTP_TOKEN=
# 第三方接口返回 JSON 中文本所在字段（逗号分隔路径，如 data.text）
OCR_HTTP_TEXT_FIELD=data.text

# ---------- 二维码跳转域名 ----------
QR_BASE_URL=https://example-campus.local/qr

# ---------- AES 加密密钥（手机号等敏感字段加密存储，生产必须更换） ----------
CRYPTO_KEY=change-me-crypto-key-16bytes!!
