/**
 * 全局样式与设计变量
 * 主色：校园蓝 #3D7EFF，点缀暖橙 #FF9F43
 * 卡片圆角 16rpx + 投影，渐变顶部
 */
page {
  --brand: #3D7EFF;
  --brand-dark: #2E63D6;
  --brand-light: #EAF1FF;
  --brand-grad: linear-gradient(160deg, #4E8BFF 0%, #3D7EFF 55%, #3A6BF0 100%);
  --warm: #FF9F43;
  --warm-light: #FFF3E6;
  --success: #34C77B;
  --danger: #F25555;
  --warning: #FFB300;
  --text-1: #1F2430;
  --text-2: #5A6270;
  --text-3: #9AA1AC;
  --bg: #F5F7FA;
  --card-bg: #FFFFFF;
  --line: #EEF1F6;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  --shadow: 0 6rpx 24rpx rgba(31, 51, 96, 0.08);
  --shadow-up: 0 -4rpx 16rpx rgba(31, 51, 96, 0.06);

  background: var(--bg);
  color: var(--text-1);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* ---------- 通用卡片 ---------- */
.card {
  background: var(--card-bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-title::before {
  content: "";
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--brand);
  margin-right: 12rpx;
}

/* ---------- 文本 ---------- */
.t-title { font-size: 34rpx; font-weight: 600; color: var(--text-1); }
.t-sub { font-size: 26rpx; color: var(--text-2); }
.t-tip { font-size: 24rpx; color: var(--text-3); }
.t-bold { font-weight: 600; }
.t-brand { color: var(--brand); }
.t-warn { color: var(--warm); }
.t-danger { color: var(--danger); }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  background: var(--brand-light);
  color: var(--brand);
  margin-right: 12rpx;
}
.tag-warm { background: var(--warm-light); color: var(--warm); }
.tag-success { background: #E8F8EF; color: var(--success); }
.tag-danger { background: #FDECEC; color: var(--danger); }
.tag-gray { background: #F0F2F5; color: var(--text-3); }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: var(--brand);
  color: #fff;
  border: none;
  line-height: 84rpx;
}
.btn::after { border: none; }
.btn-warm { background: var(--warm); }
.btn-plain {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid var(--brand);
  box-sizing: border-box;
}
.btn-ghost {
  background: var(--brand-light);
  color: var(--brand);
}
.btn-disabled { opacity: 0.5; }
.btn-sm { height: 64rpx; line-height: 64rpx; font-size: 26rpx; padding: 0 28rpx; display: inline-flex; border-radius: 12rpx; }
.btn-block { width: 100%; }

/* ---------- 表单 ---------- */
.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: var(--text-2); margin-bottom: 10rpx; display: block; }
.form-input, .form-textarea {
  background: #F6F8FB;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: auto;
  box-sizing: border-box;
}
.form-textarea { width: 100%; min-height: 160rpx; }
.form-picker {
  background: #F6F8FB;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.form-picker .placeholder { color: var(--text-3); }

/* ---------- 骨架屏 ---------- */
.skeleton {
  position: relative;
  overflow: hidden;
  background: #EDF0F5;
  border-radius: 8rpx;
}
.skeleton::after {
  content: "";
  position: absolute;
  top: 0; left: -30%;
  width: 30%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
  animation: shimmer 1.2s infinite;
}
@keyframes shimmer {
  from { left: -30%; }
  to { left: 100%; }
}
.sk-line { height: 28rpx; margin-bottom: 20rpx; }
.sk-card { height: 160rpx; border-radius: 16rpx; margin-bottom: 24rpx; }

/* ---------- 状态条 ---------- */
.state-block {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-icon { font-size: 80rpx; margin-bottom: 20rpx; }

/* ---------- 渐变头部 ---------- */
.page-header {
  background: var(--brand-grad);
  padding: 32rpx 32rpx 96rpx;
  color: #fff;
}
.page-header .header-title { font-size: 38rpx; font-weight: 600; }
.page-header .header-sub { font-size: 26rpx; opacity: 0.85; margin-top: 8rpx; }

/* ---------- 顶部压卡布局 ---------- */
.header-overlap {
  margin-top: -72rpx;
  position: relative;
  z-index: 2;
}

/* ---------- 网格 ---------- */
.grid-4 {
  display: flex;
  flex-wrap: wrap;
}
.grid-4 .grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}
.grid-4 .grid-icon {
  width: 88rpx; height: 88rpx;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  margin-bottom: 10rpx;
}
.grid-4 .grid-text { font-size: 24rpx; color: var(--text-2); }

/* ---------- 徽标 / 红点 ---------- */
.badge-dot {
  display: inline-block;
  min-width: 32rpx; height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

/* ---------- 图片九宫格 ---------- */
.img-grid {
  display: flex;
  flex-wrap: wrap;
}
.img-grid .img-cell {
  width: 196rpx; height: 196rpx;
  margin: 6rpx;
  border-radius: 12rpx;
  background: #F0F2F5;
  overflow: hidden;
}
.img-grid .img-cell image { width: 100%; height: 100%; }

/* ---------- 空态按钮 ---------- */
.divider { height: 2rpx; background: var(--line); margin: 20rpx 0; }
.flex-row { display: flex; align-items: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }
