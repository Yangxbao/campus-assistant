.empty-wrap {
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon { font-size: 88rpx; margin-bottom: 20rpx; opacity: 0.7; }
.empty-text { font-size: 28rpx; color: #5A6270; }
.empty-sub { font-size: 24rpx; color: #9AA1AC; margin-top: 10rpx; text-align: center; }
.empty-btn {
  margin-top: 32rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 44rpx;
  border-radius: 34rpx;
  background: #EAF1FF;
  color: #3D7EFF;
  font-size: 26rpx;
}
.empty-btn::after { border: none; }
