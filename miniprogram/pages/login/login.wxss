.login-page {
  min-height: 100vh;
  background: var(--brand-grad);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 60rpx;
  box-sizing: border-box;
}
.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  margin-bottom: 80rpx;
}
.login-logo { font-size: 120rpx; margin-bottom: 20rpx; }
.login-title { font-size: 44rpx; font-weight: 700; }
.login-sub { font-size: 26rpx; opacity: 0.85; margin-top: 12rpx; }

.dev-banner {
  width: 100%;
  box-sizing: border-box;
  background: #FFF6E5;
  color: #B26A00;
  border: 2rpx dashed #FFB300;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.login-card {
  width: 100%;
  box-sizing: border-box;
}
.login-tip {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 32rpx;
  text-align: center;
}
.logged-info { margin-bottom: 32rpx; }
.login-footer {
  margin-top: auto;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  padding-top: 60rpx;
}
