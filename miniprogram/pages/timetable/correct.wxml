<skeleton wx:if="{{loading}}" type="detail" />
<empty
  wx:elif="{{error}}"
  mode="error"
  sub="识别结果加载失败"
  btnText="重新加载"
  bind:action="retry"
/>
<empty
  wx:elif="{{courses.length === 0}}"
  mode="empty"
  text="没有识别到课程"
  sub="可回课程表页手动录入"
  btnText="去手动录入"
  bind:action="goManual"
/>
<block wx:else>
  <view class="card head-card">
    <view class="flex-between">
      <view class="view-tabs">
        <view class="v-tab {{view === 'grid' ? 'v-tab-on' : ''}}" bindtap="switchView" data-view="grid">周视图</view>
        <view class="v-tab {{view === 'list' ? 'v-tab-on' : ''}}" bindtap="switchView" data-view="list">列表</view>
      </view>
      <view class="t-tip">共 {{courses.length}} 条识别结果</view>
    </view>
    <view class="t-tip" style="margin-top:12rpx">⚠️ 以下为 OCR 识别结果，请逐条核对修正后再保存</view>
  </view>

  <!-- 周视图 -->
  <view class="grid-card" wx:if="{{view === 'grid'}}">
    <view class="grid-head">
      <view class="corner"></view>
      <view class="day-label" wx:for="{{columns}}" wx:key="weekday">周{{item.label}}</view>
    </view>
    <view class="grid-body">
      <view class="time-col">
        <view class="time-cell" wx:for="{{maxPeriod}}" wx:key="*this">
          <view class="time-no">{{index + 1}}</view>
        </view>
      </view>
      <view class="day-col" wx:for="{{columns}}" wx:key="weekday" wx:for-item="col">
        <view
          class="cell {{cell.covered ? 'cell-covered' : ''}}"
          wx:for="{{col.cells}}"
          wx:for-item="cell"
          wx:key="p"
        >
          <view
            wx:if="{{cell.course}}"
            class="course-block"
            style="height:{{cell.course.blockH}}rpx;background:{{cell.course.bg}};color:{{cell.course.color}}"
          >
            <view class="course-name ellipsis-2">{{cell.course.courseName}}</view>
            <view class="course-room ellipsis">{{cell.course.roomRawText}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="t-tip" style="text-align:center;padding-top:16rpx">周视图仅供预览，请到列表逐条校正</view>
  </view>

  <!-- 列表视图 -->
  <block wx:else>
    <view class="card c-card" wx:for="{{courses}}" wx:key="index">
      <view class="flex-between">
        <view class="flex-row flex-1">
          <view class="c-bar" style="background:{{item.color}}"></view>
          <view class="flex-1">
            <view class="t-bold ellipsis">{{item.courseName || '（未命名课程）'}}</view>
            <view class="t-tip">{{item.weekdayText}} {{item.timeText}}{{item.roomRawText ? ' · ' + item.roomRawText : ''}}</view>
          </view>
        </view>
        <text class="tag tag-warm" wx:if="{{item.lowConfidence}}">低置信度</text>
      </view>
      <view class="c-meta">
        <text class="tag tag-gray">{{item.teacher || '教师未知'}}</text>
        <text class="tag tag-gray">{{item.weeksText || '每周'}}</text>
        <text class="t-tip">{{item.confidenceText}}</text>
      </view>
      <view class="c-actions">
        <button class="btn btn-ghost btn-sm" bindtap="openEdit" data-index="{{index}}">编辑</button>
        <button class="btn btn-sm btn-del" bindtap="removeCourse" data-index="{{index}}">移除</button>
      </view>
    </view>
    <button class="btn btn-ghost btn-block add-btn" bindtap="openAdd">＋ 添加一条课程</button>
  </block>

  <!-- 底部确认栏 -->
  <view class="confirm-bar">
    <button class="btn btn-block {{saving ? 'btn-disabled' : ''}}" bindtap="confirmAll">
      ✓ 确认无误，保存 {{courses.length}} 条到我的课表
    </button>
    <view class="t-tip" style="text-align:center;margin-top:12rpx">确认后才会保存，绝不静默写入</view>
  </view>

  <!-- 编辑弹层 -->
  <view class="mask" wx:if="{{showEdit}}">
    <view class="popup">
      <view class="p-title">{{editIsNew ? '添加课程' : '校正课程'}}</view>
      <view class="form-item">
        <text class="form-label">课程名称 *</text>
        <input class="form-input" placeholder="课程名" value="{{form.courseName}}" data-key="courseName" bindinput="onFormInput" />
      </view>
      <view class="form-item">
        <text class="form-label">教师</text>
        <input class="form-input" placeholder="选填" value="{{form.teacher}}" data-key="teacher" bindinput="onFormInput" />
      </view>
      <view class="form-item form-row2">
        <view class="form-col">
          <text class="form-label">星期</text>
          <picker range="{{weekdayOptions}}" value="{{form.weekday - 1}}" bindchange="onFormWeekday">
            <view class="form-picker">{{weekdayOptions[form.weekday - 1]}} ▾</view>
          </picker>
        </view>
        <view class="form-col">
          <text class="form-label">开始节次</text>
          <picker range="{{weekNoOptions}}" value="{{form.startPeriod - 1}}" bindchange="onFormStart">
            <view class="form-picker">第{{form.startPeriod}}节 ▾</view>
          </picker>
        </view>
        <view class="form-col">
          <text class="form-label">结束节次</text>
          <picker range="{{weekNoOptions}}" value="{{form.endPeriod - 1}}" bindchange="onFormEnd">
            <view class="form-picker">第{{form.endPeriod}}节 ▾</view>
          </picker>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">重复方式</text>
        <picker range="{{weekTypeOptions}}" range-key="label" value="{{weekTypeIndex}}" bindchange="onFormWeekType">
          <view class="form-picker">{{weekTypeOptions[weekTypeIndex].label}} ▾</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">周次（如 1-16周 或 1,3,5，留空为每周）</text>
        <input class="form-input" placeholder="如 1-16周" value="{{form.weeksText}}" data-key="weeksText" bindinput="onFormInput" />
      </view>
      <view class="form-item">
        <text class="form-label">教室</text>
        <input class="form-input" placeholder="教室文本" value="{{form.roomRawText}}" data-key="roomRawText" bindinput="onFormInput" />
      </view>
      <view class="p-actions">
        <button class="btn btn-plain p-btn" bindtap="closeEdit">取消</button>
        <button class="btn p-btn" bindtap="saveEdit">确定</button>
      </view>
    </view>
  </view>
</block>
