page { background: var(--bg); padding-bottom: 220rpx; }

.head-card { margin-top: 24rpx; }
.view-tabs {
  display: flex;
  background: #F0F2F5;
  border-radius: 12rpx;
  padding: 6rpx;
}
.v-tab {
  padding: 12rpx 36rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.v-tab-on { background: #fff; color: var(--brand); font-weight: 600; }

/* 周视图 */
.grid-card {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin: 0 24rpx 24rpx;
  padding: 16rpx;
}
.grid-head { display: flex; }
.corner { width: 76rpx; flex-shrink: 0; }
.day-label { flex: 1; text-align: center; font-size: 24rpx; color: var(--text-2); padding: 10rpx 0; }
.grid-body { display: flex; }
.time-col { width: 76rpx; flex-shrink: 0; }
.time-cell {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 2rpx dashed var(--line);
}
.time-no { font-size: 24rpx; color: var(--text-2); }
.day-col { flex: 1; min-width: 0; border-left: 2rpx solid var(--line); }
.cell {
  height: 120rpx;
  box-sizing: border-box;
  border-top: 2rpx dashed var(--line);
  padding: 2rpx;
  overflow: hidden;
}
.cell-covered { border-top: none; }
.course-block { border-radius: 10rpx; padding: 10rpx 12rpx; box-sizing: border-box; overflow: hidden; }
.course-name { font-size: 22rpx; font-weight: 600; line-height: 1.3; }
.course-room { font-size: 18rpx; opacity: 0.85; margin-top: 4rpx; }

/* 列表 */
.c-card { padding: 24rpx; }
.c-bar { width: 8rpx; height: 64rpx; border-radius: 4rpx; margin-right: 20rpx; flex-shrink: 0; }
.c-meta { margin-top: 14rpx; display: flex; align-items: center; flex-wrap: wrap; }
.c-meta .tag { margin-top: 8rpx; }
.c-actions { margin-top: 18rpx; display: flex; }
.c-actions .btn { margin-right: 16rpx; }
.btn-del { background: #FDECEC; color: var(--danger); }
.add-btn { width: calc(100% - 48rpx); margin: 0 24rpx 24rpx; }

/* 底部确认栏 */
.confirm-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-up);
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 22, 36, 0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.popup {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 82vh;
  overflow-y: auto;
}
.p-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.p-actions { display: flex; margin-top: 28rpx; }
.p-btn { flex: 1; margin: 0 10rpx; }
.form-row2 { display: flex; }
.form-col { flex: 1; margin-right: 12rpx; }
.form-col:last-child { margin-right: 0; }
