page { background: var(--bg); }

.header-actions { display: flex; }
.h-btn {
  background: rgba(255, 255, 255, 0.22);
  border-radius: 28rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #fff;
  margin-left: 12rpx;
}

.week-bar {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.w-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  color: #fff;
  font-size: 32rpx;
}
.w-text { color: #fff; font-size: 28rpx; font-weight: 600; padding: 0 16rpx; }
.w-quick {
  margin-left: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 22rpx;
}
.w-quick-on { background: #fff; color: var(--brand); font-weight: 600; }
.next-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 10rpx;
  padding: 12rpx 20rpx;
}

/* ---------- 周视图网格 ---------- */
.grid-card {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin: 0 24rpx 24rpx;
  padding: 16rpx;
}
.grid-head { display: flex; }
.corner { width: 76rpx; flex-shrink: 0; }
.day-label {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
  padding: 10rpx 0;
}
.day-today { color: var(--brand); font-weight: 600; }
.grid-body { display: flex; }
.time-col { width: 76rpx; flex-shrink: 0; }
.time-cell {
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-top: 2rpx dashed var(--line);
}
.time-no { font-size: 24rpx; color: var(--text-2); font-weight: 600; }
.time-txt { font-size: 18rpx; color: var(--text-3); margin-top: 4rpx; }
.day-col { flex: 1; min-width: 0; border-left: 2rpx solid var(--line); }
.day-col-today { background: rgba(61, 126, 255, 0.04); }
.cell {
  height: 120rpx;
  box-sizing: border-box;
  border-top: 2rpx dashed var(--line);
  padding: 2rpx;
  overflow: hidden;
}
.cell-covered { border-top: none; }
.course-block {
  border-radius: 10rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.course-name { font-size: 22rpx; font-weight: 600; line-height: 1.3; }
.course-room { font-size: 18rpx; opacity: 0.85; margin-top: 4rpx; }
.grid-tip { text-align: center; padding-bottom: 8rpx; }
.remind-row { text-align: center; color: var(--brand); padding-bottom: 40rpx; }

.today-row { padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.today-row:last-child { border-bottom: none; }
.today-bar {
  width: 8rpx;
  height: 64rpx;
  border-radius: 4rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 22, 36, 0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.popup {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 82vh;
  overflow-y: auto;
}
.popup-form { border-radius: 32rpx 32rpx 0 0; }
.p-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.p-row { font-size: 28rpx; color: var(--text-1); margin-bottom: 16rpx; line-height: 1.6; }
.p-label {
  display: inline-block;
  width: 88rpx;
  color: var(--text-3);
  font-size: 26rpx;
}
.p-actions { display: flex; margin-top: 28rpx; }
.p-btn { flex: 1; margin: 0 10rpx; }
.btn-del { background: #FDECEC; color: var(--danger); }

.form-row2 { display: flex; }
.form-col { flex: 1; margin-right: 12rpx; }
.form-col:last-child { margin-right: 0; }

.week-chips { display: flex; flex-wrap: wrap; }
.week-chip {
  width: 76rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #F0F2F5;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
  margin: 6rpx 10rpx 6rpx 0;
}
.week-chip-on { background: var(--brand-light); color: var(--brand); font-weight: 600; }
.week-all { font-size: 24rpx; }
