page { background: var(--bg); padding-top: 24rpx; }

.avatar-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0 24rpx;
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #F0F2F5;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.save-btn { margin-left: 16rpx; flex-shrink: 0; }
.op-btn { margin-top: 8rpx; }
.delete-btn {
  width: 100%;
  margin-top: 16rpx;
  background: #FDECEC;
  color: var(--danger);
}
