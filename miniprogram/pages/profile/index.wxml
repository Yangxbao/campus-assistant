<view class="page-header profile-header">
  <view class="flex-row" wx:if="{{hasToken && userInfo}}">
    <view class="avatar-wrap" bindtap="onChangeAvatar">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-ph">👤</view>
      <view class="avatar-badge">📷</view>
    </view>
    <view class="flex-1">
      <view class="header-title">{{userInfo.nickname || '同学'}}</view>
      <view class="header-sub">贡献值 {{userInfo.contributeCount || 0}}</view>
    </view>
  </view>
  <view class="flex-row" wx:else bindtap="goLogin">
    <view class="avatar avatar-ph">👤</view>
    <view class="flex-1">
      <view class="header-title">未登录</view>
      <view class="header-sub">点击登录，解锁课表 / 收藏 / 失物招领</view>
    </view>
    <text class="arrow-w">›</text>
  </view>
</view>

<!-- 菜单 -->
<view class="card header-overlap">
  <view
    class="menu-row"
    wx:for="{{menus}}"
    wx:key="key"
    data-key="{{item.key}}"
    bindtap="onMenu"
  >
    <view class="menu-icon">{{item.icon}}</view>
    <view class="menu-label flex-1">{{item.label}}</view>
    <text class="badge-dot" wx:if="{{item.badge && unreadCount > 0}}">
      {{unreadCount > 99 ? '99+' : unreadCount}}
    </text>
    <text class="arrow">›</text>
  </view>
</view>

<!-- 其他 -->
<view class="card">
  <view class="menu-row" bindtap="openPrivacy">
    <view class="menu-icon">🛡</view>
    <view class="menu-label flex-1">隐私说明</view>
    <text class="arrow">›</text>
  </view>
  <view class="menu-row" bindtap="logout" wx:if="{{hasToken}}">
    <view class="menu-icon">🚪</view>
    <view class="menu-label flex-1 t-danger">退出登录</view>
  </view>
  <view class="t-tip" style="text-align:center;padding-top:12rpx">
    学生社区服务项目 · 非学校官方应用 · 数据含演示数据
  </view>
</view>

<!-- 隐私说明弹层 -->
<view class="mask" wx:if="{{showPrivacy}}" bindtap="closePrivacy">
  <view class="popup" catchtap="noop">
    <view class="p-title">隐私说明</view>
    <scroll-view scroll-y class="privacy-body">
      <text>{{privacyText}}</text>
    </scroll-view>
    <button class="btn btn-block" bindtap="closePrivacy">我知道了</button>
  </view>
</view>
