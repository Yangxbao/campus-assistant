<empty
  wx:if="{{!hasToken}}"
  mode="empty"
  text="登录后查看我发布的失物招领"
  btnText="去登录"
  bind:action="goLogin"
/>
<block wx:else>
  <view class="status-tabs">
    <view
      class="s-tab {{statusIndex === index ? 's-tab-on' : ''}}"
      wx:for="{{statusTabs}}"
      wx:key="value"
      data-index="{{index}}"
      bindtap="onStatus"
    >{{item.label}}</view>
  </view>

  <view class="list-wrap">
    <skeleton wx:if="{{loading}}" type="card" />
    <empty
      wx:elif="{{error}}"
      mode="error"
      sub="接口异常或网络不畅"
      btnText="重新加载"
      bind:action="retry"
    />
    <empty
      wx:elif="{{list.length === 0}}"
      text="还没有发布过信息"
      btnText="去发布"
      bind:action="goPublish"
    />
    <block wx:else>
      <view class="mi-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image wx:if="{{item.cover}}" class="mi-thumb" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="mi-thumb mi-thumb-ph">📦</view>
        <view class="flex-1">
          <view class="flex-between">
            <view class="t-bold ellipsis flex-1">{{item.title}}</view>
            <text class="tag {{item.kind === 'LOST' ? 'tag-warm' : 'tag-success'}}">{{item.kindText}}</text>
          </view>
          <view class="mi-meta">
            <text class="tag tag-gray">{{item.statusText}}</text>
            <text class="tag tag-gray" wx:if="{{item.auditText && item.auditStatus !== 'APPROVED'}}">{{item.auditText}}</text>
            <text class="t-tip">{{item.timeText}}</text>
          </view>
          <view class="t-tip" wx:if="{{item.auditStatus === 'PENDING'}}">⏳ 审核通过后才会公开展示</view>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="load-more t-tip" wx:if="{{hasMore}}" bindtap="loadMore">
        {{loadingMore ? '加载中…' : '上拉加载更多'}}
      </view>
      <view class="load-more t-tip" wx:else>— 没有更多了 —</view>
    </block>
  </view>
</block>
