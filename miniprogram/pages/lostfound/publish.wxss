page { background: var(--bg); padding-top: 24rpx; }

.kind-switch {
  display: flex;
  background: #F0F2F5;
  border-radius: 14rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}
.k-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 10rpx;
  font-size: 27rpx;
  color: var(--text-2);
}
.k-btn-lost { background: #fff; color: var(--warm); font-weight: 600; }
.k-btn-found { background: #fff; color: var(--success); font-weight: 600; }

.form-row2 { display: flex; }
.form-col { flex: 1; margin-right: 12rpx; }
.form-col:last-child { margin-right: 0; }
.picker-arrow { color: var(--text-3); }

.img-grid { display: flex; flex-wrap: wrap; }
.img-cell {
  width: 176rpx;
  height: 176rpx;
  margin: 6rpx;
  border-radius: 12rpx;
  background: #F0F2F5;
  overflow: hidden;
  position: relative;
}
.img-cell image { width: 100%; height: 100%; }
.img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 24rpx;
  border-radius: 0 0 0 12rpx;
}
.img-add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: var(--text-3);
  box-sizing: border-box;
  border: 2rpx dashed #D5DBE4;
}

.visible-row { margin-top: 16rpx; }
.pub-tip { text-align: center; margin-top: 16rpx; }
