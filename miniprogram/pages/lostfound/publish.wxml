<view class="card">
  <view class="kind-switch">
    <view class="k-btn {{kind === 'LOST' ? 'k-btn-lost' : ''}}" bindtap="switchKind" data-kind="LOST">
      😢 我丢了东西
    </view>
    <view class="k-btn {{kind === 'FOUND' ? 'k-btn-found' : ''}}" bindtap="switchKind" data-kind="FOUND">
      🙌 我捡到了东西
    </view>
  </view>

  <view class="form-item">
    <text class="form-label">物品名称 *</text>
    <input class="form-input" placeholder="如 蓝色水杯 / 校园卡" value="{{title}}" bindinput="onTitle" />
  </view>

  <view class="form-item">
    <text class="form-label">类别 *</text>
    <picker range="{{categories}}" value="{{catIndex < 0 ? 0 : catIndex}}" bindchange="onCat">
      <view class="form-picker">
        {{catIndex >= 0 ? categories[catIndex] : '请选择类别'}}
        <text class="picker-arrow">▾</text>
      </view>
    </picker>
  </view>

  <view class="form-item">
    <text class="form-label">描述</text>
    <textarea class="form-textarea" placeholder="物品特征、发生经过等（有助匹配）" value="{{description}}" bindinput="onDesc" />
  </view>

  <view class="form-item form-row2">
    <view class="form-col">
      <text class="form-label">发生日期 *</text>
      <picker mode="date" value="{{date}}" bindchange="onDate">
        <view class="form-picker">{{date || '选择日期'}} ▾</view>
      </picker>
    </view>
    <view class="form-col">
      <text class="form-label">时间</text>
      <picker mode="time" value="{{time}}" bindchange="onTime">
        <view class="form-picker">{{time || '12:00'}} ▾</view>
      </picker>
    </view>
  </view>

  <view class="form-item">
    <text class="form-label">楼宇</text>
    <picker range="{{buildings}}" range-key="name" value="{{buildingIndex < 0 ? 0 : buildingIndex}}" bindchange="onBuilding">
      <view class="form-picker">
        {{buildingIndex >= 0 ? buildings[buildingIndex].name : '选择楼宇（可选）'}}
        <text class="picker-arrow">▾</text>
      </view>
    </picker>
  </view>

  <view class="form-item">
    <text class="form-label">具体地点</text>
    <input class="form-input" placeholder="如 三楼自习室靠窗" value="{{locationDesc}}" bindinput="onLocation" />
  </view>

  <view class="form-item">
    <text class="form-label">照片（最多 6 张）</text>
    <view class="img-grid">
      <view class="img-cell" wx:for="{{images}}" wx:key="path">
        <image src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage" />
        <view class="img-del" catchtap="removeImage" data-index="{{index}}">✕</view>
      </view>
      <view class="img-cell img-add" wx:if="{{images.length < 6}}" bindtap="chooseImages">
        <text>{{uploading ? '上传中…' : '＋'}}</text>
      </view>
    </view>
  </view>

  <view class="form-item">
    <text class="form-label">联系方式</text>
    <input class="form-input" placeholder="手机 / 微信 / QQ" value="{{contactValue}}" bindinput="onContact" />
    <view class="flex-between visible-row">
      <text class="t-sub">公开展示联系方式</text>
      <switch checked="{{contactVisible}}" color="#3D7EFF" bindchange="onVisible" />
    </view>
    <view class="t-tip" wx:if="{{!contactVisible}}">关闭后他人只能通过"认领申请"联系你</view>
  </view>

  <button
    class="btn btn-block {{submitting ? 'btn-disabled' : ''}}"
    bindtap="submit"
  >{{submitting ? '提交中…' : '提交发布'}}</button>
  <view class="t-tip pub-tip">提交后需审核通过才公开展示</view>
</view>
