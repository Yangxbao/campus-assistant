/* 教室详情页样式（全局通用样式见 app.wxss） */

/* ===== 顶部信息卡 ===== */
.detail-header {
  padding: 36rpx 32rpx 96rpx;
  background: var(--brand-grad);
  color: #fff;
}
.d-room { font-size: 38rpx; font-weight: 600; line-height: 1.3; }
.d-meta { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.d-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 12rpx 12rpx 0;
}
.d-updated { font-size: 24rpx; opacity: 0.8; margin-top: 8rpx; }
.d-actions { display: flex; margin-top: 24rpx; }
.d-act {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.16);
  margin-right: 16rpx;
}
.d-act:last-child { margin-right: 0; }
.d-act-on { background: rgba(255, 214, 79, 0.9); color: #5A4500; font-weight: 600; }

/* ===== 实时状态卡 ===== */
.status-line { display: flex; margin-bottom: 16rpx; }
.status-cell { flex: 1; text-align: center; }
.status-val { font-size: 34rpx; font-weight: 600; color: var(--text-1); }
.status-val.s-free { color: var(--success); }
.status-val.s-full { color: var(--danger); }
.status-val.s-partly { color: var(--warning); }
.status-empty { padding: 28rpx; }

/* ===== 设备清单 ===== */
.equip-grid { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.equip-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.equip-icon { font-size: 44rpx; opacity: 0.35; }
.equip-icon.on { opacity: 1; }
.equip-name { font-size: 24rpx; color: var(--text-2); margin-top: 6rpx; }
.equip-state { font-size: 22rpx; color: var(--text-3); }
.equip-state.on { color: var(--success); }

/* ===== 插座标记 ===== */
.mark-image-wrap { margin-bottom: 24rpx; }
.mark-image-box { position: relative; border-radius: var(--radius); overflow: hidden; }
.mark-img { width: 100%; display: block; }
.mark-dot {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  margin-left: -22rpx;
  margin-top: -22rpx;
  border-radius: 50%;
  background: rgba(255, 179, 0, 0.45);
  border: 2rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mark-dot-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--warning);
  border: 2rpx solid #fff;
}
.mark-dot-temp { background: rgba(61, 126, 255, 0.45); }
.mark-dot-temp .mark-dot-inner { background: var(--brand); }
.mark-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.mark-row:last-child { border-bottom: none; }
.arrow { color: var(--text-3); font-size: 32rpx; margin-left: 12rpx; }

/* ===== 照片分类 tab ===== */
.cat-tabs { white-space: nowrap; margin-bottom: 16rpx; }
.cat-tab {
  display: inline-block;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: #F0F2F5;
  margin-right: 14rpx;
}
.cat-tab.cat-on { background: var(--brand); color: #fff; }

/* ===== 文字导航 ===== */
.guide-text {
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--text-1);
  background: var(--brand-light);
  border-radius: var(--radius);
  padding: 24rpx;
  white-space: pre-line;
}

/* ===== 评价 ===== */
.review-item { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.review-item:last-of-type { border-bottom: none; }
.review-stars { color: var(--warning); font-size: 28rpx; }
.stars { display: flex; }
.star { font-size: 40rpx; color: #D8DDE5; margin-right: 8rpx; }
.star-on { color: var(--warning); }

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: var(--shadow-up);
  z-index: 20;
}
.bottom-bar .btn { margin-right: 16rpx; font-size: 28rpx; padding: 18rpx 0; }
.bottom-bar .btn:last-child { margin-right: 0; }

/* ===== 弹层 ===== */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 22, 34, 0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.popup {
  width: 100%;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow-y: auto;
  box-sizing: border-box;
}
.popup-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }

/* ===== 上传照片 ===== */
.upload-preview {
  width: 320rpx;
  height: 240rpx;
  margin: 8rpx auto 24rpx;
  border: 2rpx dashed var(--text-3);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.upload-img { width: 100%; height: 100%; }
.upload-plus { font-size: 64rpx; color: var(--text-3); line-height: 1; margin-bottom: 12rpx; }

/* ===== 标记插座选图 ===== */
.mark-picker-box { position: relative; border-radius: var(--radius); overflow: hidden; margin-bottom: 16rpx; }
.mark-pick-img { width: 100%; display: block; }
